{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lalica",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Run the Worker near its database and APIs rather than near each visitor.
  // Without this, every query from a page in Nairobi would cross to the
  // database region and back, which is slower than Vercel's single region.
  "placement": { "mode": "smart" },
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "keep_vars": true,
  "workers_dev": true,
  "observability": { "enabled": true },
  // Page cache for open-next.config.ts.
  "kv_namespaces": [
    { "binding": "NEXT_INC_CACHE_KV", "id": "8c8a01a8a3734883a699027aef657c40" },
    { "binding": "NEXT_TAG_CACHE_KV", "id": "a966a07f6a924e1d843e2403bea9f37b" }
  ]
}
