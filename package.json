{
  "name": "lalica-website",
  "version": "1.0.0",
  "private": true,
  "description": "Corporate website and lightweight CMS for Lalica Engineering Limited.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:dashes": "tsx scripts/check-forbidden-dashes.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:local": "python3 scripts/local-db.py",
    "admin:bootstrap": "tsx scripts/bootstrap-admin.ts",
    "content:export": "tsx scripts/export-content.ts",
    "enquiries:purge": "tsx scripts/purge-enquiries.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.4",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@neondatabase/serverless": "1.1.0",
    "@upstash/ratelimit": "2.0.8",
    "@upstash/redis": "1.38.4",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "2.8.0",
    "better-auth": "1.7.4",
    "drizzle-orm": "0.45.2",
    "next": "16.3.4",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "6.27.0",
    "sharp": "^0.35.4",
    "zod": "4.6.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.0.1",
    "drizzle-kit": "0.31.10",
    "eslint": "10.10.0",
    "eslint-config-next": "16.3.4",
    "jsdom": "30.0.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  },
  "engines": {
    "node": ">=20.9.0"
  }
