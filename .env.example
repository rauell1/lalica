# Lalica Engineering Limited website and CMS
# Copy to .env.local for local development. Production values live in the
# Vercel project environment settings. Never commit real secrets.

# --- Required everywhere -------------------------------------------------
# Neon PostgreSQL connection string. Use the unpooled (direct) connection
# string for the app. Migrations run with the pooled connection string,
# see docs/deployment.md.
DATABASE_URL=

# Authentication secret. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public origin of the deployment, for example https://www.lalicaengineering.com
# Set this only after the domain is connected to Vercel and ownership is
# verified. Local development uses http://localhost:3000.
PUBLIC_APP_URL=http://localhost:3000

# --- Authentication ------------------------------------------------------
# Google sign-in for staff (recommended). Create OAuth credentials at
# https://console.cloud.google.com/apis/credentials with the callback URL
# {PUBLIC_APP_URL}/api/auth/callback/google. Leave unset to disable.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional email/password fallback for invited staff. Keep disabled
# (default) and prefer Google sign-in. Requires an email provider setup.
AUTH_ALLOW_EMAIL_PASSWORD=false

# --- Local demo mode ONLY ------------------------------------------------
# Enables demo staff sign-in buttons on /admin/login. The production build
# rejects demo authentication even if this is accidentally set.
AUTH_DEMO_MODE_ENABLED=true

# --- Rate limiting -------------------------------------------------------
# Upstash Redis (https://console.upstash.com/redis). Required for
# production; without it, public submissions and admin mutations fail
# closed with a temporary error. For local demos the in-memory limiter is
# used automatically.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Explicitly allow the in-memory limiter in a production build. Only use
# this for closed acceptance environments; never for the live site.
# ALLOW_LOCAL_LIMITER=false

# --- Media storage -------------------------------------------------------
# Vercel Blob read/write token (https://vercel.com/docs/storage/vercel-blob).
# Required for image uploads in production; local demos write to ./storage.
BLOB_READ_WRITE_TOKEN=

# --- Enquiry notifications -----------------------------------------------
# Resend API key (https://resend.com). The FROM address must be verified
# in Resend and match the site domain. Leave unset to disable notifications
# (enquiries are still stored and shown in the admin area).
RESEND_API_KEY=
EMAIL_FROM=website@lalicaengineering.com
EMAIL_TO=info@lalicaengineering.com

# --- Enquiry bot challenge ------------------------------------------------
# Cloudflare Turnstile (https://developers.cloudflare.com/turnstile).
# Leave unset to run with the honeypot and rate limiting only.
ENQUIRY_TURNSTILE_SECRET=
NEXT_PUBLIC_ENQUIRY_TURNSTILE_SITE_KEY=

# --- Enquiry retention -----------------------------------------------------
# Days before resolved enquiries are deleted by scripts/purge-enquiries.ts.
ENQUIRY_RETENTION_DAYS=365
